# ==========================================================================
# SUPABASE DATABASE CONFIGURATION
# ==========================================================================
# Obtain these from your Supabase Dashboard: Settings -> Database & API

# Option 1: Direct PostgreSQL Connection URI (Recommended)
# Example: postgresql://postgres.yourprojectref:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_URL=

# Option 2: Supabase Project API URL and API Key
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your-supabase-anon-or-service-role-key

# Option 3: Standard PostgreSQL Host Parameters (if not using full URI)
DB_HOST=
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=
DB_NAME=postgres

# Flask Application Settings
SECRET_KEY=hostel_management_supabase_secret_key_2026
FLASK_ENV=development
FLASK_DEBUG=True
