# CodePilot AI — Environment Configuration Example

# AI Provider Configuration (gemini, openai, or leave blank for offline AST Static Engine)
AI_PROVIDER=gemini
AI_MODEL=gemini-1.5-flash
GEMINI_API_KEY=
OPENAI_API_KEY=

# Execution Sandbox Mode (safe_local or docker)
EXECUTION_MODE=safe_local

# Maximum self-repair retry attempts
MAX_REPAIR_ATTEMPTS=2

# MySQL Database Configuration
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=codepilot_db
DB_USER=codepilot_user
DB_PASSWORD=your_password_here
DATABASE_URL=mysql+pymysql://codepilot_user:your_encoded_password@127.0.0.1:3306/codepilot_db

# Test Database Configuration
TEST_DB_NAME=codepilot_test_db
TEST_DATABASE_URL=mysql+pymysql://codepilot_user:your_encoded_password@127.0.0.1:3306/codepilot_test_db
